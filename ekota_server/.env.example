# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. PostGIS extension must be enabled on the DB.
DATABASE_URL="postgresql://ekota_backend:your_password@localhost:5432/ekota_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5001

# ─── Email (Nodemailer — for OTP verification & password reset) ───────────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_app_password"

# ─── KYC — Didit Integration (from Abrar) ────────────────────────────────────
DIDIT_API_KEY="your_didit_api_key"
DIDIT_WEBHOOK_SECRET="your_didit_webhook_secret"

# ─── Push Notifications — Firebase Admin SDK (from Adit) ─────────────────────
# Path to your Firebase service account JSON file, OR paste the JSON inline.
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'

# ─── Payments — SSLCommerz (from Adit) ───────────────────────────────────────
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASS="your_sslcommerz_store_password"
SSLCOMMERZ_IS_LIVE=false
