generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RENTER
  INVESTOR
  PRODUCER
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  FUNDING
  FULLY_FUNDED
  IN_PRODUCTION
  DELIVERED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(150)
  phoneNumber     String?   @map("phone_number") @db.VarChar(20)
  role            UserRole
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isBlocked       Boolean   @default(false) @map("is_blocked")
  blockedReason   String?   @map("blocked_reason")
  kycStatus       KycStatus @default(UNVERIFIED) @map("kyc_status")
  diditSessionId  String?   @map("didit_session_id") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  listings        Listing[]
  comments        Comment[]
  reviews         Review[]

  @@map("users")
}

model OtpVerification {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  otpCode   String   @map("otp_code") @db.VarChar(10)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean   @default(false) @map("is_used")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("otp_verifications")
}

model Listing {
  id                 String   @id @default(uuid()) @db.Uuid
  assetName          String
  category           String
  fundingTarget      Float
  rentalPrice        Float
  description        String
  specifications     String?
  imageUrls          String[]
  videoUrls          String[]
  productionTimeType String   // 'instant', 'scheduled'
  productionDays     Int?
  
  // Statuses
  status             String   @default("active")
  campaignStatus     String   @default("funding")
  
  // Derived / computed fields
  upvotes            Int      @default(0)
  downvotes          Int      @default(0)
  
  producerId         String   @db.Uuid
  producer           User     @relation(fields: [producerId], references: [id])
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  comments           Comment[]
  reviews            Review[]
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  text       String
  listingId  String   @db.Uuid
  listing    Listing  @relation(fields: [listingId], references: [id])
  authorId   String   @db.Uuid
  author     User     @relation(fields: [authorId], references: [id])
  reply      String?  // The producer's reply
  createdAt  DateTime @default(now())
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  rating     Int
  text       String
  listingId  String   @db.Uuid
  listing    Listing  @relation(fields: [listingId], references: [id])
  authorId   String   @db.Uuid
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
}