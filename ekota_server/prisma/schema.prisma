generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  ADMIN
  RENTER
  INVESTOR
  PRODUCER
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  FUNDING
  FULLY_FUNDED
  IN_PRODUCTION
  DELIVERED
}

enum StorageLocation {
  HOME
  WAREHOUSE
}

enum RentalStatus {
  AVAILABLE
  RENTED
  RETURNED
}

enum VoteType {
  INCREASE
  DECREASE
  HOLD
}

enum ProposalStatus {
  ACTIVE
  PASSED
  REJECTED
  EXPIRED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(150)
  phoneNumber     String?   @map("phone_number") @db.VarChar(20)
  role            UserRole
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isBlocked       Boolean   @default(false) @map("is_blocked")
  blockedReason   String?   @map("blocked_reason")
  kycStatus       KycStatus @default(UNVERIFIED) @map("kyc_status")
  diditSessionId  String?   @map("didit_session_id") @db.VarChar(255)
  fcmToken        String?   @map("fcm_token") @db.VarChar(255)
  walletBalance   Decimal   @default(0.00) @map("wallet_balance") @db.Decimal(18, 8)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  listings              Listing[]
  comments              Comment[]
  reviews               Review[]
  payments              Payment[]
  producerBalance       ProducerBalance?
  withdrawalRequests    WithdrawalRequest[] @relation("ProducerWithdrawals")
  reviewedWithdrawals   WithdrawalRequest[] @relation("AdminReviewedWithdrawals")
  notifications         Notification[]
  investments           Investment[]
  rentals               Rental[]
  rentPriceVotes        RentPriceVote[]
  locationSubscriptions LocationSubscription[]
  watchlists            Watchlist[]

  @@map("users")
}

model OtpVerification {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  otpCode   String   @map("otp_code") @db.VarChar(10)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean   @default(false) @map("is_used")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("otp_verifications")
}

enum PaymentStatus {
  PENDING
  VALIDATED
  FAILED
  CANCELLED
}

enum PaymentType {
  RENT
  INVESTMENT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum WithdrawalMethod {
  BANK_TRANSFER
  BKASH
  NAGAD
  ROCKET
}

enum NotificationType {
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PROCESSED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  GENERAL
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  tranId         String        @unique @map("tran_id") @db.VarChar(100)
  valId          String?       @map("val_id") @db.VarChar(100)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("BDT") @db.VarChar(10)
  paymentType    PaymentType   @map("payment_type")
  status         PaymentStatus @default(PENDING)
  gatewayPageUrl String?       @map("gateway_page_url") @db.Text
  cardType       String?       @map("card_type") @db.VarChar(100)
  bankTranId     String?       @map("bank_tran_id") @db.VarChar(100)
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ProducerBalance {
  id                String   @id @default(uuid()) @db.Uuid
  producerId        String   @unique @map("producer_id") @db.Uuid
  totalEarnings     Decimal  @default(0.00) @map("total_earnings") @db.Decimal(12, 2)
  availableBalance  Decimal  @default(0.00) @map("available_balance") @db.Decimal(12, 2)
  pendingWithdrawal Decimal  @default(0.00) @map("pending_withdrawal") @db.Decimal(12, 2)
  totalWithdrawn    Decimal  @default(0.00) @map("total_withdrawn") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  producer User @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@map("producer_balances")
}

model WithdrawalRequest {
  id             String           @id @default(uuid()) @db.Uuid
  producerId     String           @map("producer_id") @db.Uuid
  amount         Decimal          @db.Decimal(12, 2)
  method         WithdrawalMethod
  accountDetails Json             @map("account_details")
  status         WithdrawalStatus @default(PENDING)
  adminNote      String?          @map("admin_note") @db.Text
  reviewedById   String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  transactionRef String?          @map("transaction_ref") @db.VarChar(100)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  producer   User  @relation("ProducerWithdrawals", fields: [producerId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AdminReviewedWithdrawals", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("withdrawal_requests")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Listing {
  id                 String          @id @default(uuid()) @db.Uuid
  assetName          String
  category           String
  fundingTarget      Float
  rentalPrice        Float
  description        String
  specifications     String?
  imageUrls          String[]
  videoUrls          String[]
  productionTimeType String          // 'instant', 'scheduled'
  productionDays     Int?

  // Physical attributes (for warehouse fee calculation)
  weightKg           Float?          @map("weight_kg")
  sizeCubicCm        Float?          @map("size_cubic_cm")
  dimensions         String?         // e.g. "120x60x80 cm"

  // Investment tracking
  currentFunded      Float           @default(0) @map("current_funded")
  storageLocation    StorageLocation @default(HOME) @map("storage_location")
  isDelivered        Boolean         @default(false) @map("is_delivered")

  // Statuses
  status             String          @default("active")
  campaignStatus     String          @default("funding")

  // Derived / computed fields
  upvotes            Int             @default(0)
  downvotes          Int             @default(0)

  producerId         String          @db.Uuid
  producer           User            @relation(fields: [producerId], references: [id])

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relations
  comments           Comment[]
  reviews            Review[]
  investments        Investment[]
  rentalPoolItem     RentalPoolItem?
  warehouseStorage   WarehouseStorage?
  productLocation    ProductLocation?
  rentPriceProposals RentPriceProposal[]
  watchlists         Watchlist[]
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  text       String
  listingId  String   @db.Uuid
  listing    Listing  @relation(fields: [listingId], references: [id])
  authorId   String   @db.Uuid
  author     User     @relation(fields: [authorId], references: [id])
  reply      String?  // The producer's reply
  createdAt  DateTime @default(now())
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  rating     Int
  text       String
  listingId  String   @db.Uuid
  listing    Listing  @relation(fields: [listingId], references: [id])
  authorId   String   @db.Uuid
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
}

// ─── Investment & Rental Ecosystem ──────────────────────────────────────────

model Investment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  listingId       String   @map("listing_id") @db.Uuid
  amount          Float
  sharePercentage Float    @map("share_percentage")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("investments")
}

model RentalPoolItem {
  id               String       @id @default(uuid()) @db.Uuid
  listingId        String       @unique @map("listing_id") @db.Uuid
  currentRentPrice Float        @map("current_rent_price")
  status           RentalStatus @default(AVAILABLE)
  listedAt         DateTime     @default(now()) @map("listed_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rentals Rental[]

  @@map("rental_pool_items")
}

model Rental {
  id             String    @id @default(uuid()) @db.Uuid
  renterId       String    @map("renter_id") @db.Uuid
  poolItemId     String    @map("pool_item_id") @db.Uuid
  startDate      DateTime  @map("start_date") @db.Timestamptz(6)
  endDate        DateTime? @map("end_date") @db.Timestamptz(6)
  dailyRate      Float     @map("daily_rate")
  totalCost      Float?    @map("total_cost")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  renter   User           @relation(fields: [renterId], references: [id], onDelete: Cascade)
  poolItem RentalPoolItem @relation(fields: [poolItemId], references: [id], onDelete: Cascade)

  @@map("rentals")
}

model RentPriceProposal {
  id             String         @id @default(uuid()) @db.Uuid
  listingId      String         @map("listing_id") @db.Uuid
  proposedPrice  Float          @map("proposed_price")
  reason         String?
  status         ProposalStatus @default(ACTIVE)
  proposedById   String         @map("proposed_by_id") @db.Uuid
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  votes   RentPriceVote[]

  @@map("rent_price_proposals")
}

model RentPriceVote {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @map("proposal_id") @db.Uuid
  voterId    String   @map("voter_id") @db.Uuid
  voteType   VoteType @map("vote_type")
  weight     Float    // The voter's share percentage at time of voting
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  proposal RentPriceProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  voter    User              @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([proposalId, voterId])
  @@map("rent_price_votes")
}

model WarehouseStorage {
  id              String   @id @default(uuid()) @db.Uuid
  listingId       String   @unique @map("listing_id") @db.Uuid
  monthlyFee      Float    @map("monthly_fee")
  isActive        Boolean  @default(true) @map("is_active")
  storedAt        DateTime @default(now()) @map("stored_at") @db.Timestamptz(6)
  lastFeePaidAt   DateTime @default(now()) @map("last_fee_paid_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("warehouse_storage")
}

model ProductLocation {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @unique @map("listing_id") @db.Uuid
  latitude  Float
  longitude Float
  address   String?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("product_locations")
}

model LocationSubscription {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  monthlyFee  Float    @map("monthly_fee")
  isActive    Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("location_subscriptions")
}

model Watchlist {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  listingId          String   @map("listing_id") @db.Uuid
  alertOnAvailable   Boolean  @default(true) @map("alert_on_available")
  alertOnPriceChange Boolean  @default(true) @map("alert_on_price_change")
  alertOnFunded      Boolean  @default(true) @map("alert_on_funded")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("watchlists")
}